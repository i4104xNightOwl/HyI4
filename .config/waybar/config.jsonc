// -*- mode: jsonc -*-
{
	"height": 15,
	"width": 1910,
	"margin-top": 5,

	"modules-left": ["group/group-power", "hyprland/workspaces", "hyprland/window", "cpu", "memory"],
	"modules-center": ["custom/cmus"],
	"modules-right": ["tray", "network", "pulseaudio", "battery", "backlight", "clock"],

	"group/group-power": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"children-class": "not-power",
			"transition-left-to-right": true,
		},
		"modules": [
			"custom/power",
			"custom/quit",
			"custom/lock",
			"custom/reboot",
		]
	},
	"custom/quit": {
		"format": "󰗼",
		"tooltip": true,
		"tooltip-format": "Signout",
		"on-click": "hyprctl dispatch exit"
	},
	"custom/lock": {
		"format": "󰍁",
		"tooltip": true,
		"tooltip-format": "Lock",
		"on-click": "swaylock"
	},
	"custom/reboot": {
		"format": "󰜉",
		"tooltip": true,
		"tooltip-format": "Reboot",
		"on-click": "reboot"
	},
	"custom/power": {
		"format": "",
		"tooltip": true,
		"tooltip-format": "Shutdown",
		"on-click": "shutdown now"
	},

	"hyprland/workspaces": {
		"format": "{icon}",
		"on-click": "activate",
		"format-icons": {
			"urgent": "",
			"active": "",
			"default": ""
			},
		"tooltip": false,
	},

	"hyprland/window": {
		"format": "{class}",
		"separate-outputs": false,
	},

	"custom/cmus": {
		"format": "{}",
		"max-length": 45,
		"interval": 1,
		"exec": "cmus-remote -C \"format_print '%F'\"",
		"exec-if": "pgrep cmus",
		"on-click": "cmus-remote -u",
		"on-scroll-up": "cmus-remote --next",
		"on-scroll-down": "cmus-remote --prev",
		"escape": true,
		"tooltip": false
	},

	"tray": {
		"icon-size": 18,
		"spacing": 10
	},

	"network": {
		"format": "{ifname}",
		"format-wifi": "  {essid}",
		"format-ethernet": "󰊗  {ipaddr}/{cidr}",
		"format-disconnected": "Finding...", 
		"tooltip-format": "󰊗  {ifname} via {gwaddr}",
		"tooltip-format-wifi": "  {essid} - {signalStrength}% \n ↑ Up: {bandwidthUpBytes} \n ↓ Down: {bandwidthDownBytes} \nEdit network in tray icon!",
		"tooltip-format-ethernet": "  {ifname} \n ↑ Up: {bandwidthUpBytes} \n ↓ Down: {bandwidthDownBytes}",
		"tooltip-format-disconnected": "Disconnected",
		"max-length": 50,
		"interval": 5,
	},

	"cpu": {
		"interval": 10,
		"format": "CPU: {}%",
		"max-length": 10
	},

	"memory": {
		"interval": 30,
		"format": "RAM: {}%",
		"max-length": 10
	},

	"backlight": {
		"device": "intel_backlight",
		"format": "{percent}% {icon}",
		"format-icons": ["", ""]
	},

	"pulseaudio": {
		"scroll-step": 5,
		"format": "<span color='#fab387'>{icon}</span> {volume}%",
		"format-icons": {
		"default": ["", "", ""]
		},
		"on-click": "pavucontrol",
		"tooltip": false
	},

	"battery": {
		"interval": 5,
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format": "{icon} {capacity}% - {time}",
		"format-charging": " {capacity}% - {time}",
		"format-time": "{H}h {M}m",
		"format-icons": [
			"", 
			"", 
			"", 
			"", 
			"" 
		],
		"max-length": 25
	},

	"clock": {
		"format": "<span color='#fab387'></span> {:%H:%M}",
		"tooltip-format": "<big><span color='#cdd6f4'>{:%Y %B}</span></big>\n<tt><small>{calendar}</small></tt>",
		"format-alt": "<span color='#eba0ac'></span> <span color='#cdd6f4'>{:%Y-%m-%d}</span>",

		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"weeks-pos": "right",
			"on-scroll": 1,
			"format": {
				"months": "<span color='#cdd6f4'><b>{}</b></span>",
				"days": "<span color='#cdd6f4'><b>{}</b></span>",
				"weeks": "<span color='#f5c2e7'><b>W{}</b></span>",
				"weekdays": "<span color='#f5c2e7'><b>{}</b></span>",
				"today": "<span color='#eba0ac'><b><u>{}</u></b></span>"
			}
		},
		"actions": {
			"on-click-right": "mode",
			"on-click-forward": "tz_up",
			"on-click-backward": "tz_down",
			"on-scroll-up": "shift_up",
			"on-scroll-down": "shift_down"
		}
	}
}
